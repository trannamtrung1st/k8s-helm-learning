{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["global"],
  "properties": {
    "global": {
      "type": "object",
      "required": [
        "workbenchPartOf",
        "workbenchNamespaces",
        "workbenchSecrets",
        "workbenchComponents",
        "workbenchRabbitMq",
        "workbenchRedis"
      ],
      "properties": {
        "workbenchPartOf": {
          "type": "string",
          "minLength": 1
        },
        "workbenchNamespaces": {
          "type": "object",
          "required": ["apps"],
          "properties": {
            "apps": {
              "type": "object",
              "required": ["name"],
              "properties": {
                "name": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "workbenchSecrets": {
          "type": "object",
          "required": ["apps"],
          "properties": {
            "apps": {
              "type": "object",
              "required": ["name"],
              "properties": {
                "name": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "workbenchComponents": {
          "type": "object",
          "required": ["platform"],
          "properties": {
            "platform": {
              "type": "object",
              "required": ["name"],
              "properties": {
                "name": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "workbenchRabbitMq": {
          "type": "object",
          "required": ["uri"],
          "properties": {
            "uri": { "type": "string", "minLength": 1 }
          }
        },
        "workbenchRedis": {
          "type": "object",
          "required": ["connectionString"],
          "properties": {
            "connectionString": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
