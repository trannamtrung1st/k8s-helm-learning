{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["global"],
  "properties": {
    "global": {
      "type": "object",
      "required": ["workbenchPartOf", "workbenchNamespaces"],
      "properties": {
        "workbenchPartOf": {
          "type": "string",
          "minLength": 1
        },
        "workbenchNamespaces": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["name", "purpose"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "purpose": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
