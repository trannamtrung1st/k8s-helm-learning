{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Workbench": {
    "DurationSecMin": 1,
    "DurationSecMax": 300,
    "CpuPercentMin": 0,
    "CpuPercentMax": 100,
    "MemoryMbMin": 0,
    "MemoryMbMax": 1024
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=workbench;Username=workbench;Password=workbench"
  },
  "RabbitMq": {
    "Uri": "amqp://workbench:workbench@localhost:5672/"
  },
  "Redis": {
    "ConnectionString": "localhost:6379,user=workbench,password=workbench"
  }
}
