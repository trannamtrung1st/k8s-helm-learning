{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Workbench": {
    "DurationSecMin": 1,
    "DurationSecMax": 300,
    "CpuPercentMin": 0,
    "CpuPercentMax": 100,
    "MemoryMbMin": 0,
    "MemoryMbMax": 1024
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=workbench;Username=workbench;Password=workbench"
  },
  "RabbitMq": {
    "Uri": "amqp://workbench:workbench@localhost:5672/",
    "ConsumerConcurrency": 4,
    "PrefetchPerConsumer": 10
  },
  "Redis": {
    "Cluster": {
      "Enabled": false
    },
    "Endpoints": [ "localhost:6379" ],
    "User": "workbench",
    "Password": "workbench"
  }
}
