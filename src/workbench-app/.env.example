# Copy to .env for local `pnpm dev` (optional fallback when public/config.js is unchanged).
# Primary runtime config: public/config.js (Kubernetes: Helm ConfigMap mount overrides /config.js).
# Compose / default: gateway on :8080. For Workbench.LocalGateway + Api via `dotnet run`, use http://localhost:5055/api.
VITE_API_BASE_URL=http://localhost:8080/api
